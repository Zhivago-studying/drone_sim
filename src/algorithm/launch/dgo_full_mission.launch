<launch>
  <!-- Full DGO chain:
       INS + UWB simulation/filter + camera angle/id match + communication + DGO
       + EKF/DGO evaluator. -->

  <arg name="csv_dir" default="$(find test)/logs" />
  <arg name="max_align_dt" default="0.08" />
  <arg name="max_dgo_align_dt" default="0.12" />
  <arg name="max_model_align_dt" default="0.03" />
  <arg name="oracle_mode" default="false" />
  <arg name="max_communication_age" default="0.5" />
  <arg name="max_communication_skew" default="0.2" />
  <arg name="max_gt_age" default="0.1" />
  <arg name="max_extrapolation_dt" default="0.30" />
  <arg name="uwb_stddev" default="0.05" />
  <arg name="uwb_dynamic_stddev" default="0.065" />
  <arg name="ins_prior_stddev_xy" default="0.25" />
  <arg name="max_dgo_correction_xy" default="0.20" />
  <arg name="max_dgo_step_xy" default="0.30" />
  <arg name="max_dgo_ins_disagreement" default="0.0" />
  <arg name="stabilize_communication_position" default="false" />
  <arg name="require_airborne_initialization" default="true" />
  <arg name="min_dgo_start_altitude" default="0.35" />
  <arg name="max_position_correction_rate" default="0.8" />
  <arg name="max_prediction_speed" default="2.0" />
  <arg name="landing_descent_rate" default="0.45" />
  <arg name="force_disarm_delay" default="2.0" />
  <arg name="publish_pos_cov_scale" default="2.0" />
  <arg name="publish_vel_cov_scale" default="6.0" />
  <arg name="flow_relative_noise_std" default="0.18" />
  <arg name="flow_base_noise_std" default="0.05" />
  <arg name="max_velocity_innovation" default="0.75" />
  <arg name="max_height_innovation_sigma" default="8.0" />
  <arg name="stop_after_mission_complete" default="true" />
  <arg name="dgo_stop_stage" default="7" />
  <arg name="publish_hold_after_stop" default="false" />
  <arg name="ignore_after_mission_complete" default="true" />
  <arg name="eval_stop_stage" default="7" />
  <arg name="count_ignored_callbacks" default="true" />
  <arg name="enable_dekf" default="true" />
  <arg name="dekf_rate" default="30.0" />
  <arg name="dekf_history_keep_time" default="1.0" />
  <arg name="dekf_delay_threshold" default="0.035" />
  <arg name="dekf_future_tolerance" default="0.02" />
  <arg name="dekf_delayed_covariance_weight" default="1.0" />
  <arg name="dekf_delayed_update_gain_weight" default="$(arg dekf_delayed_covariance_weight)" />
  <arg name="dekf_max_nis" default="25.0" />
	  <arg name="dekf_max_nis_dgo" default="11.34" />
	  <arg name="dekf_max_nis_dgo_dynamic" default="16.27" />
	  <arg name="dekf_max_nis_dgo_velocity" default="16.27" />
  <arg name="dekf_max_nis_uwb" default="12.0" />
  <arg name="dekf_max_nis_camera_1d" default="9.0" />
  <arg name="dekf_max_nis_camera_2d" default="13.8" />
  <arg name="dekf_uwb_residual_gate" default="0.8" />
  <arg name="dekf_dgo_residual_gate" default="2.0" />
  <arg name="dekf_dgo_velocity_residual_gate" default="2.0" />
  <arg name="dekf_camera_residual_gate" default="0.5" />
  <arg name="dekf_require_direction_anchor_for_uwb" default="true" />
  <arg name="dekf_uwb_anchor_max_age" default="0.50" />
  <arg name="dekf_enable_dgo_recovery" default="true" />
  <arg name="dekf_dgo_recovery_gate" default="3.0" />
  <arg name="dekf_dgo_recovery_count_threshold" default="3" />
  <arg name="dekf_dgo_recovery_consistency_gate" default="0.50" />
  <arg name="dekf_dgo_recovery_cooldown" default="1.0" />
  <arg name="dekf_dgo_recovery_pos_std" default="0.20" />
  <arg name="dekf_dgo_recovery_vel_std" default="0.50" />
  <arg name="dekf_clear_history_on_recovery" default="true" />
  <arg name="dekf_allow_dgo_x_only_on_bad_cov" default="false" />
  <arg name="dekf_max_position_cov" default="2.0" />
  <arg name="dekf_max_velocity_cov" default="1.0" />
  <arg name="dekf_max_pending" default="100" />
  <arg name="dekf_max_history_match_dt" default="0.06" />
  <arg name="enable_pairwise_eval" default="true" />
  <arg name="pairwise_max_sync_dt" default="0.05" />
  <arg name="dekf_max_observation_delay" default="0.60" />
	  <arg name="dekf_max_dgo_pair_dt" default="0.12" />
	  <arg name="dekf_dgo_velocity_pair_max_dt" default="0.05" />
	  <arg name="dekf_dgo_consecutive_gate_fail_threshold" default="3" />
  <arg name="dekf_accel_noise_std" default="0.8" />
  <arg name="dekf_dgo_position_noise_std" default="0.08" />
  <arg name="dekf_uwb_noise_std" default="$(arg uwb_stddev)" />
	  <arg name="dekf_camera_alpha_noise_std" default="0.05" />
	  <arg name="dekf_camera_theta_noise_std" default="0.05" />
		  <arg name="dekf_use_dgo_velocity" default="true" />
	  <arg name="dekf_dgo_velocity_noise_std" default="0.25" />
	  <arg name="dekf_use_dgo_velocity_stage_gate" default="true" />
	  <arg name="dekf_dgo_velocity_noise_std_dynamic" default="0.35" />
	  <arg name="dekf_dgo_velocity_noise_std_landing" default="0.70" />
	  <arg name="dekf_disable_dgo_velocity_in_landing" default="true" />
	  <arg name="max_dekf_align_dt" default="0.12" />
  <arg name="mode" default="4" />
		  <arg name="delayed_validation_enabled" default="false" />
		  <arg name="delayed_validation_gt_max_dt" default="0.05" />
		  <arg name="dekf_trace_enabled" default="true" />
	  <arg name="dekf_trace_dgo_only" default="true" />
	  <arg name="dekf_enable_position_cov_floor" default="true" />
	  <arg name="dekf_position_cov_floor_std" default="0.08" />
	  <arg name="dekf_position_cov_floor_stage_dynamic_only" default="true" />
	  <arg name="dekf_enable_stage_dependent_q" default="true" />
	  <arg name="dekf_dynamic_q_scale" default="1.75" />
	  <arg name="dekf_landing_q_scale" default="1.0" />
	  <arg name="dekf_enable_stage_dependent_dgo_r" default="false" />
	  <arg name="dekf_dynamic_dgo_position_noise_std" default="0.08" />
	  <arg name="dekf_landing_dgo_position_noise_std" default="0.10" />
	  <arg name="dekf_enable_dgo_health_adaptive_r" default="true" />
	  <arg name="dekf_dgo_health_good_sigma_p" default="0.08" />
	  <arg name="dekf_dgo_health_normal_sigma_p" default="0.10" />
  <arg name="dekf_dgo_health_suspect_sigma_p" default="0.15" />
  <arg name="dekf_dgo_health_bad_sigma_p" default="0.20" />
  <arg name="dekf_dgo_health_bad_reject" default="false" />
  <arg name="dekf_dgo_health_window_size" default="20" />
  <arg name="dekf_dgo_health_ema_alpha" default="0.15" />
  <arg name="dekf_dgo_health_residual_good" default="0.08" />
  <arg name="dekf_dgo_health_residual_bad" default="0.25" />
  <arg name="dekf_dgo_health_nis_good" default="3.0" />
  <arg name="dekf_dgo_health_nis_bad" default="12.0" />
  <arg name="dekf_dgo_health_vel_res_good" default="0.20" />
  <arg name="dekf_dgo_health_vel_res_bad" default="0.60" />
  <arg name="dekf_dgo_health_replay_delta_good" default="-0.005" />
  <arg name="dekf_dgo_health_replay_delta_bad" default="0.002" />
  <arg name="dekf_dgo_health_enable_uwb_consistency" default="true" />
  <arg name="dekf_dgo_health_uwb_consistency_good" default="0.06" />
  <arg name="dekf_dgo_health_uwb_consistency_bad" default="0.20" />
  <arg name="dekf_dgo_health_uwb_consistency_weight" default="1.5" />
  <arg name="dekf_dgo_health_uwb_max_age" default="0.20" />

  <arg name="dekf_dgo_health_enable_bidirectional_consistency" default="true" />
  <arg name="dekf_dgo_health_bidirectional_good" default="0.08" />
  <arg name="dekf_dgo_health_bidirectional_bad" default="0.35" />
  <arg name="dekf_dgo_health_bidirectional_weight" default="0.0" />
  <arg name="dekf_dgo_health_bidirectional_max_dt" default="0.08" />
	  <arg name="run_id" default="" />

  <!--
    run_id 机制: 当 run_id 非空时, 所有 CSV 输出重定向到
    ~/swarm_localization/run_data/run_{run_id}/{node_category}/
    空值时使用原默认路径 (向后兼容)
  -->
  <arg if="$(eval arg('run_id') != '')"
       name="log_base"
       value="$(eval env('HOME') + '/swarm_localization/run_data/run_' + str(arg('run_id')))" />

  <arg name="dgo_csv_dir"       value="$(arg csv_dir)"
       unless="$(eval arg('run_id') != '')" />
  <arg name="dgo_csv_dir"       value="$(arg log_base)/dgo"
       if="$(eval arg('run_id') != '')" />
  <arg name="ekf_test_csv_dir"  value="$(arg csv_dir)"
       unless="$(eval arg('run_id') != '')" />
  <arg name="ekf_test_csv_dir"  value="$(arg log_base)/ekf_dgo_test"
       if="$(eval arg('run_id') != '')" />
  <arg name="uwb_csv_dir"       value=""
       unless="$(eval arg('run_id') != '')" />
  <arg name="uwb_csv_dir"       value="$(arg log_base)/uwb_zero_score"
       if="$(eval arg('run_id') != '')" />
  <arg name="ins_flow_csv_dir"  value=""
       unless="$(eval arg('run_id') != '')" />
  <arg name="ins_flow_csv_dir"  value="$(arg log_base)/ins_eskf"
       if="$(eval arg('run_id') != '')" />
  <arg name="ins_ekf_test_csv_dir"  value="$(arg csv_dir)"
       unless="$(eval arg('run_id') != '')" />
  <arg name="ins_ekf_test_csv_dir"  value="$(arg log_base)/ins_eskf_test"
       if="$(eval arg('run_id') != '')" />
  <arg name="dekf_csv_dir"       value=""
       unless="$(eval arg('run_id') != '')" />
  <arg name="dekf_csv_dir"       value="$(arg log_base)/dekf"
       if="$(eval arg('run_id') != '')" />
  <arg name="formation_csv_dir"  value="/home/scott/swarm_localization/src/sensors/logs"
       unless="$(eval arg('run_id') != '')" />
  <arg name="formation_csv_dir"  value="$(arg log_base)/formation"
       if="$(eval arg('run_id') != '')" />

  <include file="$(find sensors)/launch/uwb.launch" />
  <include file="$(find data_process)/launch/uwb_zero_score.launch">
    <arg name="csv_dir" value="$(arg uwb_csv_dir)" />
  </include>

  <group ns="iris_0">
    <node pkg="data_process" type="ins_eskf" name="ins_eskf" output="screen">
      <rosparam command="load" file="$(find data_process)/config/ins_eskf_noise.yaml" />
      <param name="disable_attitude_update" value="false" />
      <param name="imu_frame" value="auto" />
      <param name="min_flow_quality" value="100" />
      <param name="publish_pos_cov_scale" value="$(arg publish_pos_cov_scale)" />
      <param name="publish_vel_cov_scale" value="$(arg publish_vel_cov_scale)" />
      <param name="flow_base_noise_std" value="$(arg flow_base_noise_std)" />
      <param name="flow_relative_noise_std" value="$(arg flow_relative_noise_std)" />
      <param name="max_velocity_innovation" value="$(arg max_velocity_innovation)" />
      <param name="max_height_innovation_sigma" value="$(arg max_height_innovation_sigma)" />
      <param name="flow_csv_dir" value="$(arg ins_flow_csv_dir)" />
    </node>
    <node pkg="data_process" type="camera_relative_angle_cal" name="camera_relative_angle_cal" output="screen" />
    <node pkg="data_process" type="id_match" name="id_match" output="screen">
      <rosparam param="drone_names">["iris_0", "iris_1", "iris_2", "iris_3"]</rosparam>
    </node>
    <node pkg="sensors" type="image.py" name="image_saver" output="screen" />
    <node pkg="data_process" type="tf_bridge.py" name="tf_bridge" output="screen" />
    <node pkg="sensors" type="communication" name="communication" output="screen">
      <param name="stabilize_position" value="$(arg stabilize_communication_position)" />
      <param name="max_dgo_ins_disagreement" value="$(arg max_dgo_ins_disagreement)" />
      <param name="max_position_correction_rate" value="$(arg max_position_correction_rate)" />
      <param name="max_prediction_speed" value="$(arg max_prediction_speed)" />
    </node>
    <node pkg="algorithm" type="DGO" name="DGO" output="screen">
      <param name="uav_id" value="0" />
      <param name="uav_num" value="4" />
      <param name="initial_spacing" value="2.0" />
      <param name="max_sensor_age" value="0.5" />
      <param name="csv_dir" value="$(arg dgo_csv_dir)" />
      <param name="oracle_mode" value="$(arg oracle_mode)" />
      <param name="max_communication_age" value="$(arg max_communication_age)" />
      <param name="max_communication_skew" value="$(arg max_communication_skew)" />
      <param name="max_gt_age" value="$(arg max_gt_age)" />
      <param name="max_extrapolation_dt" value="0.30" />
      <param name="uwb_stddev" value="$(arg uwb_stddev)" />
      <param name="uwb_dynamic_stddev" value="$(arg uwb_dynamic_stddev)" />
      <param name="ins_prior_stddev_xy" value="$(arg ins_prior_stddev_xy)" />
      <param name="max_dgo_correction_xy" value="$(arg max_dgo_correction_xy)" />
      <param name="max_dgo_step_xy" value="$(arg max_dgo_step_xy)" />
      <param name="require_airborne_initialization" value="$(arg require_airborne_initialization)" />
      <param name="min_dgo_start_altitude" value="$(arg min_dgo_start_altitude)" />
      <param name="fusion_period" value="0.10" />
      <param name="fixed_lag" value="0.20" />
      <param name="history_keep_time" value="2.0" />
      <param name="max_fuse_retry_lag" value="1.0" />
      <param name="stop_after_mission_complete" value="$(arg stop_after_mission_complete)" />
      <param name="dgo_stop_stage" value="$(arg dgo_stop_stage)" />
      <param name="publish_hold_after_stop" value="$(arg publish_hold_after_stop)" />
      <!-- DGO camera robust constraints (stage 1) -->
      <param name="enable_camera_residual_gate" value="true" />
      <param name="camera_alpha_gate" value="0.15" />
      <param name="camera_theta_gate" value="0.12" />
      <param name="camera_xy_gate" value="0.30" />
      <param name="enable_camera_huber" value="true" />
      <param name="camera_angle_huber_delta" value="3.0" />
      <param name="camera_xy_huber_delta" value="3.0" />
      <param name="max_camera_age_static" value="0.30" />
      <param name="max_camera_age_dynamic" value="0.18" />
      <param name="max_camera_age_chase" value="0.15" />
    </node>
    <node if="$(arg enable_dekf)" pkg="algorithm" type="my_dekf" name="my_dekf" output="screen">
      <param name="uav_id" value="0" />
      <param name="uav_num" value="4" />
      <param name="rate" value="$(arg dekf_rate)" />
      <param name="sigma_ax" value="$(arg dekf_accel_noise_std)" />
      <param name="sigma_ay" value="$(arg dekf_accel_noise_std)" />
      <param name="sigma_az" value="$(arg dekf_accel_noise_std)" />
      <param name="sigma_px" value="$(arg dekf_dgo_position_noise_std)" />
      <param name="sigma_py" value="$(arg dekf_dgo_position_noise_std)" />
      <param name="sigma_pz" value="$(arg dekf_dgo_position_noise_std)" />
      <param name="sigma_uwb" value="$(arg dekf_uwb_noise_std)" />
      <param name="mode" value="$(arg mode)" />
      <param name="delayed_validation_enabled" value="$(arg delayed_validation_enabled)" />
      <param name="delayed_validation_gt_max_dt" value="$(arg delayed_validation_gt_max_dt)" />
      <param name="trace_enabled" value="$(arg dekf_trace_enabled)" />
      <param name="trace_dgo_only" value="$(arg dekf_trace_dgo_only)" />
      <param name="sigma_alpha" value="$(arg dekf_camera_alpha_noise_std)" />
      <param name="sigma_theta" value="$(arg dekf_camera_theta_noise_std)" />
      <param name="use_dgo_velocity" value="$(arg dekf_use_dgo_velocity)" />
      <param name="dgo_velocity_noise_std" value="$(arg dekf_dgo_velocity_noise_std)" />
      <param name="use_dgo_velocity_stage_gate" value="$(arg dekf_use_dgo_velocity_stage_gate)" />
      <param name="dgo_velocity_noise_std_dynamic" value="$(arg dekf_dgo_velocity_noise_std_dynamic)" />
      <param name="dgo_velocity_noise_std_landing" value="$(arg dekf_dgo_velocity_noise_std_landing)" />
      <param name="disable_dgo_velocity_in_landing" value="$(arg dekf_disable_dgo_velocity_in_landing)" />
      <param name="max_dgo_pair_dt" value="$(arg dekf_max_dgo_pair_dt)" />
      <param name="max_observation_delay" value="$(arg dekf_max_observation_delay)" />
      <param name="current_delay_threshold" value="$(arg dekf_delay_threshold)" />
      <param name="future_tolerance" value="$(arg dekf_future_tolerance)" />
      <param name="delayed_update_gain_weight" value="$(arg dekf_delayed_update_gain_weight)" />
      <param name="max_nis" value="$(arg dekf_max_nis)" />
      <param name="max_nis_dgo" value="$(arg dekf_max_nis_dgo)" />
      <param name="max_nis_dgo_velocity" value="$(arg dekf_max_nis_dgo_velocity)" />
      <param name="max_nis_uwb" value="$(arg dekf_max_nis_uwb)" />
      <param name="max_nis_camera_1d" value="$(arg dekf_max_nis_camera_1d)" />
      <param name="max_nis_camera_2d" value="$(arg dekf_max_nis_camera_2d)" />
      <param name="uwb_residual_gate" value="$(arg dekf_uwb_residual_gate)" />
      <param name="dgo_residual_gate" value="$(arg dekf_dgo_residual_gate)" />
      <param name="dgo_velocity_residual_gate" value="$(arg dekf_dgo_velocity_residual_gate)" />
      <param name="camera_residual_gate" value="$(arg dekf_camera_residual_gate)" />
      <param name="require_direction_anchor_for_uwb" value="$(arg dekf_require_direction_anchor_for_uwb)" />
      <param name="uwb_anchor_max_age" value="$(arg dekf_uwb_anchor_max_age)" />
      <param name="enable_dgo_recovery" value="$(arg dekf_enable_dgo_recovery)" />
      <param name="dgo_recovery_gate" value="$(arg dekf_dgo_recovery_gate)" />
      <param name="dgo_recovery_count_threshold" value="$(arg dekf_dgo_recovery_count_threshold)" />
      <param name="dgo_consecutive_gate_fail_threshold" value="$(arg dekf_dgo_consecutive_gate_fail_threshold)" />
      <param name="dgo_velocity_pair_max_dt" value="$(arg dekf_dgo_velocity_pair_max_dt)" />
      <param name="max_nis_dgo_dynamic" value="$(arg dekf_max_nis_dgo_dynamic)" />
      <param name="dgo_recovery_consistency_gate" value="$(arg dekf_dgo_recovery_consistency_gate)" />
      <param name="dgo_recovery_cooldown" value="$(arg dekf_dgo_recovery_cooldown)" />
      <param name="dgo_recovery_pos_std" value="$(arg dekf_dgo_recovery_pos_std)" />
      <param name="dgo_recovery_vel_std" value="$(arg dekf_dgo_recovery_vel_std)" />
      <param name="clear_history_on_recovery" value="$(arg dekf_clear_history_on_recovery)" />
      <param name="allow_dgo_x_only_on_bad_cov" value="$(arg dekf_allow_dgo_x_only_on_bad_cov)" />
      <param name="max_position_cov" value="$(arg dekf_max_position_cov)" />
      <param name="max_velocity_cov" value="$(arg dekf_max_velocity_cov)" />
      <param name="max_pending" value="$(arg dekf_max_pending)" />
      <param name="history_keep_time" value="$(arg dekf_history_keep_time)" />
      <!-- Position covariance floor -->
      <param name="enable_position_cov_floor" value="$(arg dekf_enable_position_cov_floor)" />
      <param name="position_cov_floor_std" value="$(arg dekf_position_cov_floor_std)" />
      <param name="position_cov_floor_stage_dynamic_only" value="$(arg dekf_position_cov_floor_stage_dynamic_only)" />
      <!-- Stage-dependent Q -->
      <param name="enable_stage_dependent_q" value="$(arg dekf_enable_stage_dependent_q)" />
      <param name="dynamic_q_scale" value="$(arg dekf_dynamic_q_scale)" />
      <param name="landing_q_scale" value="$(arg dekf_landing_q_scale)" />
      <!-- Stage-dependent DGO position R -->
      <param name="enable_stage_dependent_dgo_r" value="$(arg dekf_enable_stage_dependent_dgo_r)" />
      <param name="dynamic_dgo_position_noise_std" value="$(arg dekf_dynamic_dgo_position_noise_std)" />
      <param name="landing_dgo_position_noise_std" value="$(arg dekf_landing_dgo_position_noise_std)" />
      <param name="enable_dgo_health_adaptive_r" value="$(arg dekf_enable_dgo_health_adaptive_r)" />
      <param name="dgo_health_good_sigma_p" value="$(arg dekf_dgo_health_good_sigma_p)" />
      <param name="dgo_health_normal_sigma_p" value="$(arg dekf_dgo_health_normal_sigma_p)" />
      <param name="dgo_health_suspect_sigma_p" value="$(arg dekf_dgo_health_suspect_sigma_p)" />
      <param name="dgo_health_bad_sigma_p" value="$(arg dekf_dgo_health_bad_sigma_p)" />
      <param name="dgo_health_bad_reject" value="$(arg dekf_dgo_health_bad_reject)" />
      <param name="dgo_health_window_size" value="$(arg dekf_dgo_health_window_size)" />
      <param name="dgo_health_ema_alpha" value="$(arg dekf_dgo_health_ema_alpha)" />
      <param name="dgo_health_residual_good" value="$(arg dekf_dgo_health_residual_good)" />
      <param name="dgo_health_residual_bad" value="$(arg dekf_dgo_health_residual_bad)" />
      <param name="dgo_health_nis_good" value="$(arg dekf_dgo_health_nis_good)" />
      <param name="dgo_health_nis_bad" value="$(arg dekf_dgo_health_nis_bad)" />
      <param name="dgo_health_vel_res_good" value="$(arg dekf_dgo_health_vel_res_good)" />
      <param name="dgo_health_vel_res_bad" value="$(arg dekf_dgo_health_vel_res_bad)" />
      <param name="dgo_health_replay_delta_good" value="$(arg dekf_dgo_health_replay_delta_good)" />
      <param name="dgo_health_replay_delta_bad" value="$(arg dekf_dgo_health_replay_delta_bad)" />
      <param name="dgo_health_enable_uwb_consistency" value="$(arg dekf_dgo_health_enable_uwb_consistency)" />
      <param name="dgo_health_uwb_consistency_good" value="$(arg dekf_dgo_health_uwb_consistency_good)" />
