<launch>
  <!--
    EKF + DGO + DEKF full mission entrypoint.

    Usage:
      roslaunch test ekf_dgo_dekf.launch run_id:=X

    CSV output when run_id is non-empty:
      ~/swarm_localization/run_data/run_X/dgo/
      ~/swarm_localization/run_data/run_X/dekf/
      ~/swarm_localization/run_data/run_X/ekf_dgo_test/
      ~/swarm_localization/run_data/run_X/ins_eskf_test/
      ~/swarm_localization/run_data/run_X/ins_eskf/
      ~/swarm_localization/run_data/run_X/uwb_zero_score/

    This launch delegates the concrete node graph to
    algorithm/launch/dgo_full_mission.launch, which starts:
      UWB simulator/filter, INS ESKF, camera pipeline, communication,
      DGO, my_dekf, formation controller, INS evaluator and DGO evaluator.
  -->

  <!-- ===== Common logging / evaluator parameters ===== -->
  <arg name="run_id" default="" />
  <arg name="csv_dir" default="$(find test)/logs" />
  <arg name="max_align_dt" default="0.08" />
  <arg name="max_dgo_align_dt" default="0.12" />
  <arg name="max_model_align_dt" default="0.03" />

  <!-- ===== DGO / communication parameters ===== -->
  <arg name="oracle_mode" default="false" />
  <arg name="max_communication_age" default="0.5" />
  <arg name="max_communication_skew" default="0.2" />
  <arg name="max_gt_age" default="0.1" />
  <arg name="max_extrapolation_dt" default="0.30" />
  <arg name="uwb_stddev" default="0.05" />
  <arg name="uwb_dynamic_stddev" default="0.065" />
  <arg name="ins_prior_stddev_xy" default="0.25" />
  <arg name="max_dgo_correction_xy" default="0.20" />
  <arg name="max_dgo_step_xy" default="0.30" />
  <arg name="max_dgo_ins_disagreement" default="0.0" />
  <arg name="stabilize_communication_position" default="false" />
  <arg name="require_airborne_initialization" default="true" />
  <arg name="min_dgo_start_altitude" default="0.35" />
  <arg name="max_position_correction_rate" default="0.8" />
  <arg name="max_prediction_speed" default="2.0" />

  <!-- ===== Formation / INS parameters ===== -->
  <arg name="landing_descent_rate" default="0.45" />
  <arg name="force_disarm_delay" default="2.0" />
  <arg name="publish_pos_cov_scale" default="2.0" />
  <arg name="publish_vel_cov_scale" default="6.0" />
  <arg name="flow_relative_noise_std" default="0.10" />
  <arg name="flow_base_noise_std" default="0.02" />
  <arg name="max_velocity_innovation" default="0.75" />
  <arg name="max_height_innovation_sigma" default="8.0" />

  <!-- ===== Mission stop / evaluator crop parameters ===== -->
  <arg name="stop_after_mission_complete" default="true" />
  <arg name="dgo_stop_stage" default="7" />
  <arg name="publish_hold_after_stop" default="false" />
  <arg name="ignore_after_mission_complete" default="true" />
  <arg name="eval_stop_stage" default="7" />
  <arg name="count_ignored_callbacks" default="true" />

  <!-- ===== DEKF parameters ===== -->
  <arg name="enable_dekf" default="true" />
  <arg name="dekf_rate" default="30.0" />
  <arg name="dekf_history_keep_time" default="1.0" />
  <arg name="dekf_delay_threshold" default="0.035" />
  <arg name="dekf_future_tolerance" default="0.02" />
  <arg name="dekf_delayed_covariance_weight" default="1.0" />
  <arg name="dekf_delayed_update_gain_weight" default="$(arg dekf_delayed_covariance_weight)" />
  <arg name="dekf_max_nis" default="25.0" />
  <arg name="dekf_max_nis_dgo" default="11.34" />
  <arg name="dekf_max_nis_dgo_velocity" default="16.27" />
  <arg name="dekf_max_nis_dgo_dynamic" default="16.27" />
  <arg name="dekf_dgo_velocity_pair_max_dt" default="0.05" />
  <arg name="dekf_dgo_consecutive_gate_fail_threshold" default="3" />
  <arg name="dekf_max_nis_uwb" default="12.0" />
  <arg name="dekf_max_nis_camera_1d" default="9.0" />
  <arg name="dekf_max_nis_camera_2d" default="13.8" />
  <arg name="dekf_uwb_residual_gate" default="0.8" />
  <arg name="dekf_dgo_residual_gate" default="2.0" />
  <arg name="dekf_dgo_velocity_residual_gate" default="2.0" />
  <arg name="dekf_camera_residual_gate" default="0.5" />
  <arg name="dekf_require_direction_anchor_for_uwb" default="true" />
  <arg name="dekf_uwb_anchor_max_age" default="0.50" />
  <arg name="dekf_enable_dgo_recovery" default="true" />
  <arg name="dekf_dgo_recovery_gate" default="3.0" />
  <arg name="dekf_dgo_recovery_count_threshold" default="3" />
  <arg name="dekf_dgo_recovery_consistency_gate" default="0.50" />
  <arg name="dekf_dgo_recovery_cooldown" default="1.0" />
  <arg name="dekf_dgo_recovery_pos_std" default="0.20" />
  <arg name="dekf_dgo_recovery_vel_std" default="0.50" />
  <arg name="dekf_clear_history_on_recovery" default="true" />
  <arg name="dekf_allow_dgo_x_only_on_bad_cov" default="false" />
  <arg name="dekf_max_position_cov" default="2.0" />
  <arg name="dekf_max_velocity_cov" default="1.0" />
  <arg name="mode" default="4" />
	  <arg name="delayed_validation_enabled" default="false" />
	  <arg name="delayed_validation_gt_max_dt" default="0.05" />
	  <arg name="dekf_trace_enabled" default="true" />
		  <arg name="dekf_trace_dgo_only" default="true" />
	  <arg name="dekf_use_dgo_velocity" default="true" />
	  <arg name="dekf_dgo_velocity_noise_std" default="0.25" />
	  <arg name="dekf_use_dgo_velocity_stage_gate" default="true" />
	  <arg name="dekf_dgo_velocity_noise_std_dynamic" default="0.35" />
	  <arg name="dekf_dgo_velocity_noise_std_landing" default="0.70" />
	  <arg name="dekf_disable_dgo_velocity_in_landing" default="true" />
	  <arg name="dekf_max_pending" default="100" />
	  <arg name="dekf_enable_position_cov_floor" default="true" />
	  <arg name="dekf_position_cov_floor_std" default="0.08" />
	  <arg name="dekf_position_cov_floor_stage_dynamic_only" default="true" />
	  <arg name="dekf_enable_stage_dependent_q" default="true" />
	  <arg name="dekf_dynamic_q_scale" default="1.75" />
	  <arg name="dekf_landing_q_scale" default="1.0" />
	  <arg name="dekf_enable_stage_dependent_dgo_r" default="false" />
	  <arg name="dekf_dynamic_dgo_position_noise_std" default="0.08" />
	  <arg name="dekf_landing_dgo_position_noise_std" default="0.10" />
	  <arg name="dekf_enable_dgo_health_adaptive_r" default="true" />
  <arg name="dekf_dgo_health_good_sigma_p" default="0.08" />
  <arg name="dekf_dgo_health_normal_sigma_p" default="0.09" />
  <arg name="dekf_dgo_health_suspect_sigma_p" default="0.12" />
  <arg name="dekf_dgo_health_bad_sigma_p" default="0.20" />
  <arg name="dekf_dgo_health_bad_reject" default="false" />
  <arg name="dekf_dgo_health_window_size" default="20" />
  <arg name="dekf_dgo_health_ema_alpha" default="0.15" />
  <arg name="dekf_dgo_health_residual_good" default="0.08" />
  <arg name="dekf_dgo_health_residual_bad" default="0.25" />
  <arg name="dekf_dgo_health_nis_good" default="3.0" />
  <arg name="dekf_dgo_health_nis_bad" default="12.0" />
  <arg name="dekf_dgo_health_vel_res_good" default="0.20" />
  <arg name="dekf_dgo_health_vel_res_bad" default="0.60" />
  <arg name="dekf_dgo_health_replay_delta_good" default="-0.005" />
  <arg name="dekf_dgo_health_replay_delta_bad" default="0.002" />
  <arg name="dekf_max_history_match_dt" default="0.06" />
  <arg name="dekf_max_observation_delay" default="0.60" />
  <arg name="dekf_max_dgo_pair_dt" default="0.12" />
  <arg name="dekf_accel_noise_std" default="0.8" />
  <arg name="dekf_dgo_position_noise_std" default="0.08" />
  <arg name="dekf_uwb_noise_std" default="$(arg uwb_stddev)" />
  <arg name="dekf_camera_alpha_noise_std" default="0.05" />
  <arg name="dekf_camera_theta_noise_std" default="0.05" />
  <arg name="max_dekf_align_dt" default="0.12" />

  <include file="$(find algorithm)/launch/dgo_full_mission.launch">
    <arg name="run_id" value="$(arg run_id)" />
    <arg name="csv_dir" value="$(arg csv_dir)" />

    <arg name="max_align_dt" value="$(arg max_align_dt)" />
    <arg name="max_dgo_align_dt" value="$(arg max_dgo_align_dt)" />
    <arg name="max_model_align_dt" value="$(arg max_model_align_dt)" />

    <arg name="oracle_mode" value="$(arg oracle_mode)" />
    <arg name="max_communication_age" value="$(arg max_communication_age)" />
    <arg name="max_communication_skew" value="$(arg max_communication_skew)" />
    <arg name="max_gt_age" value="$(arg max_gt_age)" />
    <arg name="max_extrapolation_dt" value="$(arg max_extrapolation_dt)" />
    <arg name="uwb_stddev" value="$(arg uwb_stddev)" />
    <arg name="uwb_dynamic_stddev" value="$(arg uwb_dynamic_stddev)" />
    <arg name="ins_prior_stddev_xy" value="$(arg ins_prior_stddev_xy)" />
    <arg name="max_dgo_correction_xy" value="$(arg max_dgo_correction_xy)" />
    <arg name="max_dgo_step_xy" value="$(arg max_dgo_step_xy)" />
    <arg name="max_dgo_ins_disagreement" value="$(arg max_dgo_ins_disagreement)" />
    <arg name="stabilize_communication_position" value="$(arg stabilize_communication_position)" />
    <arg name="require_airborne_initialization" value="$(arg require_airborne_initialization)" />
    <arg name="min_dgo_start_altitude" value="$(arg min_dgo_start_altitude)" />
    <arg name="max_position_correction_rate" value="$(arg max_position_correction_rate)" />
    <arg name="max_prediction_speed" value="$(arg max_prediction_speed)" />

    <arg name="landing_descent_rate" value="$(arg landing_descent_rate)" />
    <arg name="force_disarm_delay" value="$(arg force_disarm_delay)" />
    <arg name="publish_pos_cov_scale" value="$(arg publish_pos_cov_scale)" />
    <arg name="publish_vel_cov_scale" value="$(arg publish_vel_cov_scale)" />
    <arg name="flow_relative_noise_std" value="$(arg flow_relative_noise_std)" />
    <arg name="flow_base_noise_std" value="$(arg flow_base_noise_std)" />
    <arg name="max_velocity_innovation" value="$(arg max_velocity_innovation)" />
    <arg name="max_height_innovation_sigma" value="$(arg max_height_innovation_sigma)" />

    <arg name="stop_after_mission_complete" value="$(arg stop_after_mission_complete)" />
    <arg name="dgo_stop_stage" value="$(arg dgo_stop_stage)" />
    <arg name="publish_hold_after_stop" value="$(arg publish_hold_after_stop)" />
    <arg name="ignore_after_mission_complete" value="$(arg ignore_after_mission_complete)" />
    <arg name="eval_stop_stage" value="$(arg eval_stop_stage)" />
    <arg name="count_ignored_callbacks" value="$(arg count_ignored_callbacks)" />

    <arg name="enable_dekf" value="$(arg enable_dekf)" />
    <arg name="dekf_rate" value="$(arg dekf_rate)" />
    <arg name="dekf_history_keep_time" value="$(arg dekf_history_keep_time)" />
    <arg name="dekf_delay_threshold" value="$(arg dekf_delay_threshold)" />
    <arg name="dekf_future_tolerance" value="$(arg dekf_future_tolerance)" />
    <arg name="dekf_delayed_covariance_weight" value="$(arg dekf_delayed_covariance_weight)" />
    <arg name="dekf_delayed_update_gain_weight" value="$(arg dekf_delayed_update_gain_weight)" />
    <arg name="dekf_max_nis" value="$(arg dekf_max_nis)" />
    <arg name="dekf_max_nis_dgo" value="$(arg dekf_max_nis_dgo)" />
	    <arg name="dekf_max_nis_dgo_velocity" value="$(arg dekf_max_nis_dgo_velocity)" />
	    <arg name="dekf_max_nis_dgo_dynamic" value="$(arg dekf_max_nis_dgo_dynamic)" />
	    <arg name="dekf_dgo_velocity_pair_max_dt" value="$(arg dekf_dgo_velocity_pair_max_dt)" />
	    <arg name="dekf_dgo_consecutive_gate_fail_threshold" value="$(arg dekf_dgo_consecutive_gate_fail_threshold)" />
	    <arg name="dekf_max_nis_uwb" value="$(arg dekf_max_nis_uwb)" />
    <arg name="dekf_max_nis_camera_1d" value="$(arg dekf_max_nis_camera_1d)" />
    <arg name="dekf_max_nis_camera_2d" value="$(arg dekf_max_nis_camera_2d)" />
    <arg name="dekf_uwb_residual_gate" value="$(arg dekf_uwb_residual_gate)" />
    <arg name="dekf_dgo_residual_gate" value="$(arg dekf_dgo_residual_gate)" />
    <arg name="dekf_dgo_velocity_residual_gate" value="$(arg dekf_dgo_velocity_residual_gate)" />
    <arg name="dekf_camera_residual_gate" value="$(arg dekf_camera_residual_gate)" />
    <arg name="dekf_require_direction_anchor_for_uwb" value="$(arg dekf_require_direction_anchor_for_uwb)" />
    <arg name="dekf_uwb_anchor_max_age" value="$(arg dekf_uwb_anchor_max_age)" />
    <arg name="dekf_enable_dgo_recovery" value="$(arg dekf_enable_dgo_recovery)" />
    <arg name="dekf_dgo_recovery_gate" value="$(arg dekf_dgo_recovery_gate)" />
    <arg name="dekf_dgo_recovery_count_threshold" value="$(arg dekf_dgo_recovery_count_threshold)" />
    <arg name="dekf_dgo_recovery_consistency_gate" value="$(arg dekf_dgo_recovery_consistency_gate)" />
    <arg name="dekf_dgo_recovery_cooldown" value="$(arg dekf_dgo_recovery_cooldown)" />
    <arg name="dekf_dgo_recovery_pos_std" value="$(arg dekf_dgo_recovery_pos_std)" />
    <arg name="dekf_dgo_recovery_vel_std" value="$(arg dekf_dgo_recovery_vel_std)" />
    <arg name="dekf_clear_history_on_recovery" value="$(arg dekf_clear_history_on_recovery)" />
    <arg name="dekf_allow_dgo_x_only_on_bad_cov" value="$(arg dekf_allow_dgo_x_only_on_bad_cov)" />
    <arg name="dekf_max_position_cov" value="$(arg dekf_max_position_cov)" />
	    <arg name="dekf_max_velocity_cov" value="$(arg dekf_max_velocity_cov)" />
		    <arg name="mode" value="$(arg mode)" />
		    <arg name="delayed_validation_enabled" value="$(arg delayed_validation_enabled)" />
		    <arg name="delayed_validation_gt_max_dt" value="$(arg delayed_validation_gt_max_dt)" />
		    <arg name="dekf_trace_enabled" value="$(arg dekf_trace_enabled)" />
		    <arg name="dekf_trace_dgo_only" value="$(arg dekf_trace_dgo_only)" />
    <arg name="dekf_max_pending" value="$(arg dekf_max_pending)" />
    <arg name="dekf_max_history_match_dt" value="$(arg dekf_max_history_match_dt)" />
    <arg name="dekf_max_observation_delay" value="$(arg dekf_max_observation_delay)" />
    <arg name="dekf_max_dgo_pair_dt" value="$(arg dekf_max_dgo_pair_dt)" />
    <arg name="dekf_accel_noise_std" value="$(arg dekf_accel_noise_std)" />
    <arg name="dekf_dgo_position_noise_std" value="$(arg dekf_dgo_position_noise_std)" />
    <arg name="dekf_uwb_noise_std" value="$(arg dekf_uwb_noise_std)" />
    <arg name="dekf_camera_alpha_noise_std" value="$(arg dekf_camera_alpha_noise_std)" />
	    <arg name="dekf_camera_theta_noise_std" value="$(arg dekf_camera_theta_noise_std)" />
	    <arg name="dekf_use_dgo_velocity" value="$(arg dekf_use_dgo_velocity)" />
	    <arg name="dekf_dgo_velocity_noise_std" value="$(arg dekf_dgo_velocity_noise_std)" />
	    <arg name="dekf_use_dgo_velocity_stage_gate" value="$(arg dekf_use_dgo_velocity_stage_gate)" />
	    <arg name="dekf_dgo_velocity_noise_std_dynamic" value="$(arg dekf_dgo_velocity_noise_std_dynamic)" />
	    <arg name="dekf_dgo_velocity_noise_std_landing" value="$(arg dekf_dgo_velocity_noise_std_landing)" />
	    <arg name="dekf_disable_dgo_velocity_in_landing" value="$(arg dekf_disable_dgo_velocity_in_landing)" />
		    <arg name="max_dekf_align_dt" value="$(arg max_dekf_align_dt)" />
		    <arg name="dekf_enable_position_cov_floor" value="$(arg dekf_enable_position_cov_floor)" />
		    <arg name="dekf_position_cov_floor_std" value="$(arg dekf_position_cov_floor_std)" />
		    <arg name="dekf_position_cov_floor_stage_dynamic_only" value="$(arg dekf_position_cov_floor_stage_dynamic_only)" />
		    <arg name="dekf_enable_stage_dependent_q" value="$(arg dekf_enable_stage_dependent_q)" />
		    <arg name="dekf_dynamic_q_scale" value="$(arg dekf_dynamic_q_scale)" />
		    <arg name="dekf_landing_q_scale" value="$(arg dekf_landing_q_scale)" />
		    <arg name="dekf_enable_stage_dependent_dgo_r" value="$(arg dekf_enable_stage_dependent_dgo_r)" />
		    <arg name="dekf_dynamic_dgo_position_noise_std" value="$(arg dekf_dynamic_dgo_position_noise_std)" />
		    <arg name="dekf_landing_dgo_position_noise_std" value="$(arg dekf_landing_dgo_position_noise_std)" />
		    <arg name="dekf_enable_dgo_health_adaptive_r" value="$(arg dekf_enable_dgo_health_adaptive_r)" />
		    <arg name="dekf_dgo_health_good_sigma_p" value="$(arg dekf_dgo_health_good_sigma_p)" />
		    <arg name="dekf_dgo_health_normal_sigma_p" value="$(arg dekf_dgo_health_normal_sigma_p)" />
		    <arg name="dekf_dgo_health_suspect_sigma_p" value="$(arg dekf_dgo_health_suspect_sigma_p)" />
		    <arg name="dekf_dgo_health_bad_sigma_p" value="$(arg dekf_dgo_health_bad_sigma_p)" />
		    <arg name="dekf_dgo_health_bad_reject" value="$(arg dekf_dgo_health_bad_reject)" />
		    <arg name="dekf_dgo_health_window_size" value="$(arg dekf_dgo_health_window_size)" />
		    <arg name="dekf_dgo_health_ema_alpha" value="$(arg dekf_dgo_health_ema_alpha)" />
      <arg name="dekf_dgo_health_residual_good" value="$(arg dekf_dgo_health_residual_good)" />
      <arg name="dekf_dgo_health_residual_bad" value="$(arg dekf_dgo_health_residual_bad)" />
      <arg name="dekf_dgo_health_nis_good" value="$(arg dekf_dgo_health_nis_good)" />
      <arg name="dekf_dgo_health_nis_bad" value="$(arg dekf_dgo_health_nis_bad)" />
      <arg name="dekf_dgo_health_vel_res_good" value="$(arg dekf_dgo_health_vel_res_good)" />
      <arg name="dekf_dgo_health_vel_res_bad" value="$(arg dekf_dgo_health_vel_res_bad)" />
      <arg name="dekf_dgo_health_replay_delta_good" value="$(arg dekf_dgo_health_replay_delta_good)" />
      <arg name="dekf_dgo_health_replay_delta_bad" value="$(arg dekf_dgo_health_replay_delta_bad)" />
	  </include>
</launch>
